{
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(which:*)",
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(ruby --version:*)",
      "Bash(bundle --version:*)",
      "Bash(npm list:*)",
      "Bash(bundle list:*)",
      "Bash(bundle info:*)",
      "Bash(bundle install:*)",
      "Bash(bundle update:*)",
      "Bash(bundle exec rails routes:*)",
      "Bash(bundle exec rails console --help:*)",
      "Bash(bundle exec rspec --dry-run:*)",
      "Bash(bundle exec rubocop --list-target-files:*)",
      "Bash(npm run:*)",
      "Bash(npm test -- --listTests:*)",
      "Bash(npm run lint -- --list-files:*)",
      "Bash(yarn run:*)",
      "Bash(pnpm run:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill(update-config)"
    ],
    "deny": [
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh api */comments:*)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "effortLevel": "high",
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
